<?xml version="1.0" encoding="utf-8"?>
<!--
  JellyAmp network security policy — COMMITTED TEMPLATE ONLY.

  Cleartext (http) is blocked by default. The only hosts allowed in this file
  are loopback; the owner's real LAN / Tailscale Jellyfin hosts are INJECTED AT
  BUILD TIME and never committed:

    * CI:      the `NSC_HOSTS` repository secret (comma/space separated hosts)
               is passed to `flutter build`; android/app/build.gradle generates
               an overlay copy of this file for the build type with those hosts
               added to the cleartext domain-config.
    * Locally: android/nsc-hosts.local (gitignored, one host per line, `#`
               comments allowed) is read by the same Gradle task.

  With no hosts configured (fresh clone, fork, PR from a stranger) this file is
  used as-is: cleartext stays off and only loopback is exempted, so the policy
  can never leak a private address into the public repository.
-->
<network-security-config>
  <base-config cleartextTrafficPermitted="false">
    <trust-anchors>
      <certificates src="system"/>
      <certificates src="user"/>
    </trust-anchors>
  </base-config>

  <!-- Loopback only: a Jellyfin running on this same device. -->
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="false">localhost</domain>
    <domain includeSubdomains="false">127.0.0.1</domain>
  </domain-config>
</network-security-config>
